format = "1"

[package]
name = "nxadmin"
version = "0.1.1"
description = "Admin panel extension for Nexa"
author = "Nexa Contributors"
license = "MIT"
type = "extension"

[distribution]
provider = "pypi"
name = "nxadmin"

[compatibility]
python_min = "3.11"
nexa_min = "0.5.0"

[extension]
cli = true
middleware = false
schema = true

[security]
verified = false
