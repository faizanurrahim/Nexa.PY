format = "1"

[package]
name = "NxAuth"
version = "0.2.0"
description = "Authentication extension for Nexa.py"
author = "Nexa Contributors"
license = "MIT"
homepage = "https://github.com/faizanurrahim/Nexa.PY"
type = "extension"

[source]
type = "github"
repository = "https://github.com/faizanurrahim/NxAuth"
tag = "v0.2.0"

[distribution]
name = "nxauth"

[compatibility]
python_min = "3.10"
nexa_min = "0.4.0"

[extension]
cli = true
middleware = true
schema = true

[security]
verified = false
